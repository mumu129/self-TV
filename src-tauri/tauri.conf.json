{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Self TV",
  "version": "1.0.0",
  "identifier": "com.selftv.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Self TV",
        "width": 1400,
        "height": 900,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOWNLOAD/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "TVBox desktop player"
  }
}
